{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node dist/standalone/server.js",
    "start:local-prod": "node scripts/start-local-prod.mjs",
    "db:init": "node scripts/init-sqlite.mjs",
    "db:backup": "node scripts/backup-sqlite.mjs",
    "test": "npm run build && node --experimental-transform-types --experimental-loader ./tests/resolve-ts-loader.mjs --test tests/rendered-html.test.mjs tests/yandex-storage.test.mjs tests/media-validation.test.mjs tests/media-client.test.mjs tests/admin-visual.test.mjs tests/admin-access.test.mjs tests/admin-api.test.mjs tests/masters.test.mjs tests/map-link.test.mjs tests/working-hours-validation.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:seed:generate": "node scripts/generate-d1-seed.mjs",
    "auth:verifier": "node scripts/create-admin-verifier.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "ipaddr.js": "^2.5.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright": "^1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13"
  },
  "type": "module"
}
