# Node/VINEXT runtime (safe placeholders only; never commit real values)
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
SQLITE_PATH=.data/site.sqlite

# Yandex Object Storage (server-side only)
YC_ACCESS_KEY_ID=replace-with-yandex-access-key
YC_SECRET_ACCESS_KEY=replace-with-yandex-secret-key
YC_BUCKET_NAME=replace-with-bucket-name
YC_ENDPOINT=https://storage.yandexcloud.net
YC_REGION=ru-central1

# Fixed administrator accounts (store PBKDF2 verifiers, never plaintext passwords)
ADMIN_OWNER_LOGIN=replace-owner-login
ADMIN_OWNER_PASSWORD_VERIFIER=pbkdf2_sha256$iterations$base64url-salt$base64url-digest
ADMIN_DEVELOPER_LOGIN=replace-developer-login
ADMIN_DEVELOPER_PASSWORD_VERIFIER=pbkdf2_sha256$iterations$base64url-salt$base64url-digest
AUTH_PASSWORD_PEPPER=replace-with-random-server-secret

# Keep disabled outside local development. This is never a production auth path.
ADMIN_DEV_BYPASS=false
